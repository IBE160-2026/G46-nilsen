# Samtalestøtte – eksempel på miljøvariabler
# Kopier denne filen til .env ved lokal utvikling.
# Legg aldri ekte API-nøkler eller hemmeligheter i Git.

OPENAI_API_KEY=

# Valgfri alternativ KI-provider
OPENROUTER_API_KEY=

OPENAI_MODEL=gpt-5.6-luna

PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APP_VERSION=20.11.1

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Valgfritt: kommaseparerte administratoradresser
# Eksempel:
# ADMIN_EMAILS=admin@example.com,admin2@example.com

ADMIN_EMAILS=
# Valgfri kontaktadresse som vises i appen
CONTACT_EMAIL=
