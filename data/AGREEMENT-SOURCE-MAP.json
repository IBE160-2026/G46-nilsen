{
  "version": 2,
  "description": "Forslagskart for tariff-/overenskomstkontekst. Systemet skal aldri anta at en arbeidstaker er omfattet av en bestemt avtale bare ut fra yrke; det skal foreslå mulige avtaleområder og be om bekreftelse når tariffkontekst faktisk er relevant.",
  "policy": {
    "assumeAgreement": false,
    "requireConfirmationBeforeUse": true,
    "useOnlyWhenRelevant": true,
    "relevantWhen": [
      "lønn",
      "arbeidstid",
      "turnus",
      "overtid",
      "tillegg",
      "reise",
      "vakt",
      "beredskap",
      "arbeidsplan",
      "forhandling",
      "opprykk",
      "lokale bestemmelser"
    ],
    "irrelevantExamples": [
      "samlivsbrudd",
      "sorg",
      "vanlig kollegakonflikt",
      "generell kommunikasjon uten avtale-/arbeidstidskobling"
    ],
    "wordingRule": "Bruk formuleringer som «kan være omfattet av» eller «relevant avtale kan være», aldri «du følger denne avtalen» uten bekreftet grunnlag.",
    "followUpFlow": {
      "trigger": "Still spørsmål om arbeidsgivertype bare når tariff/overenskomst faktisk kan påvirke rådet.",
